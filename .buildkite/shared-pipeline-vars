#!/bin/sh

 # This file is `source`'d before calling `buildkite-agent pipeline upload`, and can be used
 # to set up some variables that will be interpolated in the `.yml` pipeline before uploading it.

export CI_TOOLKIT="automattic/a8c-ci-toolkit#8.0.1"
export TEST_COLLECTOR="test-collector#v1.10.1"
export CLAUDE_PLUGIN="iangmaia/claude-summarize#ce99c67dd57cdf236c3daca82b86a335fd5e9cc2"

# false (or an empty result after an error) runs the job. The pipeline uses these as skip values.
SKIP_BUILD=$(.buildkite/commands/should-skip-job.sh --job-type build || true)
SKIP_VALIDATION=$(.buildkite/commands/should-skip-job.sh --job-type validation || true)
SKIP_LINT=$(.buildkite/commands/should-skip-job.sh --job-type lint || true)
SKIP_LIBRARY_LINT=$(.buildkite/commands/should-skip-job.sh --job-type library-lint || true)
export SKIP_BUILD SKIP_VALIDATION SKIP_LINT SKIP_LIBRARY_LINT

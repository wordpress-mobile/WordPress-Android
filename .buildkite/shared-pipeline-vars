#!/bin/sh

 # This file is `source`'d before calling `buildkite-agent pipeline upload`, and can be used
 # to set up some variables that will be interpolated in the `.yml` pipeline before uploading it.

export CI_TOOLKIT="automattic/a8c-ci-toolkit#6.3.0"
export TEST_COLLECTOR="test-collector#v1.10.1"
export CLAUDE_PLUGIN="iangmaia/claude-summarize#ce99c67dd57cdf236c3daca82b86a335fd5e9cc2"

# Skip decision for the Lint Libraries step, made here on the upload agent so that a skipped job never waits for an agent.
# `false` runs the step, anything else is the reason to skip it. The pipeline uses it as `skip: "$SKIP_LIBRARY_LINT"`.
# Any failure keeps the step: this file is sourced with `bash -e`, so nothing here may fail.
SKIP_LIBRARY_LINT=false
if .buildkite/commands/should-skip-job.sh --job-type library-lint >/dev/null; then
  SKIP_LIBRARY_LINT="No relevant files changed"
fi
export SKIP_LIBRARY_LINT
echo "SKIP_LIBRARY_LINT=$SKIP_LIBRARY_LINT"

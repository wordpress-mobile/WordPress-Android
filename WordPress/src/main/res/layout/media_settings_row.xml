<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/MediaSettings.Row"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/row_label"
        style="@style/MediaSettings.RowLabel"
        tools:text="Title" />

    <TextView
        android:id="@+id/row_value"
        style="@style/MediaSettings.RowValue"
        tools:text="a-monkey-wearing-a-seersucker-suit" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_pencil_white_24dp"
        app:tint="?attr/wpColorOnSurfaceMedium" />
</LinearLayout>

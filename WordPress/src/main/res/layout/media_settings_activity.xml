<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:focusableInTouchMode="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="false">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="false"
            app:expandedTitleMarginEnd="64dp"
            app:expandedTitleMarginStart="48dp"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_collapseMode="parallax">

                <ImageView
                    android:id="@+id/image_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/media_settings_background"
                    android:contentDescription="@string/media_settings_image_preview_desc"
                    android:scaleType="centerCrop"
                    tools:layout_height="224dp"
                    tools:src="@drawable/ic_audio_white_24dp"
                    tools:tint="@color/neutral_30" />

                <ImageView
                    android:id="@+id/image_gradient_scrim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    app:srcCompat="@drawable/collapsing_toolbar_gradient_scrim"
                    android:contentDescription="@null"
                    tools:layout_height="74dp" />

                <ImageView
                    android:id="@+id/image_play"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/media_settings_play"
                    android:src="@drawable/ic_play_white_black_24dp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <ImageButton
                    android:id="@+id/button_fullscreen"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_media_fullscreen_button"
                    android:contentDescription="@string/button_preview"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_fullscreen_white_24dp"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </FrameLayout>

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@null"
                android:elevation="0dp"
                app:layout_collapseMode="pin"
                app:theme="@style/WordPress.ActionBar" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <org.wordpress.android.widgets.WPNestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- summary -->
            <TextView
                android:id="@+id/text_filename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorOnSurface"
                android:textIsSelectable="true"
                android:textSize="18sp"
                tools:text="beach-dog.png" />

            <TextView
                android:id="@+id/text_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="16dp"
                android:textColor="?attr/wpColorOnSurfaceMedium"
                android:textSize="14sp"
                tools:text="PNG · 1024 × 768 · 980.77 KB" />

            <!-- customize (editor only) -->
            <LinearLayout
                android:id="@+id/media_customisation_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/MediaSettings.SectionHeader"
                    android:text="@string/media_edit_customize_card_caption" />

                <LinearLayout style="@style/MediaSettings.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="10dp">

                        <TextView
                            style="@style/MediaSettings.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/image_size" />

                        <TextView
                            android:id="@+id/image_size_hint"
                            style="@style/MediaSettings.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Large" />

                        <SeekBar
                            android:id="@+id/image_size_seekbar"
                            style="@style/Widget.AppCompat.SeekBar.Discrete"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="-8dp"
                            android:layout_marginTop="@dimen/margin_large"
                            android:layout_marginEnd="-8dp"
                            tools:max="3" />
                    </LinearLayout>

                    <View style="@style/MediaSettings.InsetDivider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/alignment_spinner_label"
                            style="@style/MediaSettings.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/image_alignment" />

                        <androidx.appcompat.widget.AppCompatSpinner
                            android:id="@+id/alignment_spinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="40dp"
                            android:prompt="@string/image_alignment"
                            app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight" />
                    </LinearLayout>

                    <View style="@style/MediaSettings.InsetDivider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/edit_link_container"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/media_edit_link_text">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edit_link"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textUri"
                                tools:text="https://example.com" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <CheckBox
                            android:id="@+id/edit_link_target_new_widnow_checkbox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_small"
                            android:text="@string/media_edit_link_hint" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- details (editable) -->
            <TextView
                style="@style/MediaSettings.SectionHeader"
                android:text="@string/media_settings_details_header" />

            <LinearLayout style="@style/MediaSettings.Card">

                <include
                    android:id="@+id/row_title"
                    layout="@layout/media_settings_row" />

                <View style="@style/MediaSettings.InsetDivider" />

                <include
                    android:id="@+id/row_caption"
                    layout="@layout/media_settings_row" />

                <View
                    android:id="@+id/divider_alt_text"
                    style="@style/MediaSettings.InsetDivider" />

                <include
                    android:id="@+id/row_alt_text"
                    layout="@layout/media_settings_row" />

                <View
                    android:id="@+id/divider_description"
                    style="@style/MediaSettings.InsetDivider" />

                <include
                    android:id="@+id/row_description"
                    layout="@layout/media_settings_row" />
            </LinearLayout>

            <!-- file info (read-only) -->
            <TextView
                style="@style/MediaSettings.SectionHeader"
                android:text="@string/media_settings_file_info_header" />

            <LinearLayout style="@style/MediaSettings.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:focusable="true"
                        android:orientation="vertical">

                        <TextView
                            style="@style/MediaSettings.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/media_edit_url_caption" />

                        <TextView
                            android:id="@+id/text_url"
                            style="@style/MediaSettings.Value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:singleLine="true"
                            tools:text="https://example.com/wp-content/uploads/beach-dog.png" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/text_copy_url"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/media_settings_copy_url"
                        android:src="@drawable/ic_copy_white_24dp"
                        app:tint="?attr/wpColorOnSurfaceMedium" />
                </LinearLayout>

                <View style="@style/MediaSettings.InsetDivider" />

                <LinearLayout
                    android:id="@+id/file_info_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp" />
            </LinearLayout>
        </LinearLayout>
    </org.wordpress.android.widgets.WPNestedScrollView>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:elevation="@dimen/card_elevation"
        android:textAppearance="?android:attr/progressBarStyle"
        android:visibility="gone"
        tools:visibility="visible" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
